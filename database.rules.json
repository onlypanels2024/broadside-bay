{
  "rules": {
    ".read": false,
    ".write": false,
    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === true"
      }
    },
    "players": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !root.child('banned').child($uid).exists()",
        ".validate": "newData.hasChildren(['n','x','z','a','t','hp','mx','rs','al']) && newData.child('t').val() === now && (!data.exists() ? (((newData.child('x').val() - (0))*(newData.child('x').val() - (0)) + (newData.child('z').val() - (0))*(newData.child('z').val() - (0)) <= 1600) || ((newData.child('x').val() - (175))*(newData.child('x').val() - (175)) + (newData.child('z').val() - (-160))*(newData.child('z').val() - (-160)) <= 1600) || ((newData.child('x').val() - (-165))*(newData.child('x').val() - (-165)) + (newData.child('z').val() - (175))*(newData.child('z').val() - (175)) <= 1600)) : (newData.child('rs').val() === data.child('rs').val() ? (((newData.child('x').val() - data.child('x').val()))*((newData.child('x').val() - data.child('x').val())) + ((newData.child('z').val() - data.child('z').val()))*((newData.child('z').val() - data.child('z').val())) <= ((now - data.child('t').val()) / 1000 * 34 + 6) * ((now - data.child('t').val()) / 1000 * 34 + 6)) : (newData.child('rs').val() === data.child('rs').val() + 1 && (((newData.child('x').val() - (0))*(newData.child('x').val() - (0)) + (newData.child('z').val() - (0))*(newData.child('z').val() - (0)) <= 1600) || ((newData.child('x').val() - (175))*(newData.child('x').val() - (175)) + (newData.child('z').val() - (-160))*(newData.child('z').val() - (-160)) <= 1600) || ((newData.child('x').val() - (-165))*(newData.child('x').val() - (-165)) + (newData.child('z').val() - (175))*(newData.child('z').val() - (175)) <= 1600)))))",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -285 && newData.val() <= 285"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -285 && newData.val() <= 285"
        },
        "a": {
          ".validate": "newData.isNumber() && newData.val() >= -20 && newData.val() <= 20"
        },
        "v": {
          ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 34"
        },
        "hp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('mx').val()"
        },
        "mx": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 18 && (!newData.parent().child('sh').exists() ? ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 5) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 5)) : ((newData.parent().child('sh').val() === 0 && ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 5) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 5))) || (newData.parent().child('sh').val() === 1 && ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 7) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 7))) || (newData.parent().child('sh').val() === 2 && ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 9) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 9))) || (newData.parent().child('sh').val() === 3 && ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 12) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 12))) || (newData.parent().child('sh').val() === 4 && ((!root.child('saves').child($uid).child('up').child('hull').exists() && newData.val() <= 15) || (root.child('saves').child($uid).child('up').child('hull').val() >= newData.val() - 15)))))"
        },
        "rs": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "c": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "al": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "sg": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "dk": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "k": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "dn": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "kb": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "s": {
          "$i": {
            ".validate": "$i.length <= 2",
            "$j": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "sh": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && (newData.val() === 0 || (newData.val() === 1 && root.child('saves').child($uid).child('ships').child('corvette').val() === true) || (newData.val() === 2 && root.child('saves').child($uid).child('ships').child('frigate').val() === true) || (newData.val() === 3 && root.child('saves').child($uid).child('ships').child('galleon').val() === true) || (newData.val() === 4 && root.child('saves').child($uid).child('ships').child('manowar').val() === true))"
        },
        "lk": {
          ".validate": "newData.isString() && newData.val() === root.child('saves').child($uid).child('paint').child('lk').val()"
        },
        "dw": {
          ".validate": "newData.isString() && newData.val() === root.child('saves').child($uid).child('paint').child('dw').val()"
        },
        "fl": {
          ".validate": "newData.isString() && root.child('saves').child($uid).child('fleet').exists() && newData.val() === root.child('fleets').child(root.child('saves').child($uid).child('fleet').val()).child('tag').val()"
        },
        "ti": {
          ".validate": "newData.isString() && newData.val() === root.child('saves').child($uid).child('title').val()"
        },
        "cx": {
          ".validate": "newData.isString() && newData.val() === root.child('saves').child($uid).child('cx').val()"
        }
      }
    },
    "hits": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('v').val() === auth.uid",
        ".validate": "newData.hasChildren(['v','s','sid','x','z','t']) && newData.child('t').val() === now",
        "v": {
          ".validate": "newData.isString()"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "sid": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -300 && newData.val() <= 300"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -300 && newData.val() <= 300"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        },
        "ti": {
          ".validate": "newData.isNumber() && newData.val() <= now + 500 && newData.val() >= now - 3000"
        }
      }
    },
    "deaths": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('v').val() === auth.uid",
        ".validate": "newData.hasChildren(['v','t']) && newData.child('t').val() === now",
        "v": {
          ".validate": "newData.isString()"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rewards": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$rid": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },
    "stats": {
      ".read": "auth != null"
    },
    "banned": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "requests": {
      "$uid": {
        "$rid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && !root.child('banned').child($uid).exists()",
          ".validate": "newData.hasChildren(['k','t']) && newData.child('t').val() === now",
          "k": {
            ".validate": "newData.isString() && newData.val().matches(/^(kill|up|repair|ship|look|check|daily|quest|fleet|title|cos|reset)$/)"
          },
          "e": {
            ".validate": "newData.isString() && newData.val().matches(/^(sloop|galleon|boss|treasure|merchant|escort|kraken)$/)"
          },
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^([a-z0-9_]{0,16})$/)"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          },
          "lk": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-z]{7}$/)"
          },
          "dw": {
            ".validate": "newData.isString() && newData.val().matches(/^([0-9a-f]{64})?$/)"
          },
          "op": {
            ".validate": "newData.isString() && newData.val().matches(/^(create|join|leave|kick)$/)"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "tag": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{2,4}$/)"
          },
          "col": {
            ".validate": "newData.isNumber()"
          },
          "em": {
            ".validate": "newData.isNumber()"
          },
          "fid": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "who": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "cx": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
          }
        }
      }
    },
    "reports": {
      "$uid": {
        "$rid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && !root.child('banned').child($uid).exists()",
          ".validate": "newData.hasChildren(['tg','dw','t']) && newData.child('t').val() === now",
          "tg": {
            ".validate": "newData.isString() && newData.val().length <= 64 && newData.val() !== $uid"
          },
          "dw": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "status": {
      ".read": "auth != null"
    },
    "board": {
      ".read": "auth != null",
      "all": {
        ".indexOn": [
          "xp"
        ]
      },
      "$week": {
        ".indexOn": [
          "s",
          "g",
          "c",
          "xp"
        ]
      }
    },
    "fleets": {
      ".read": "auth != null"
    },
    "fleettags": {
      ".indexOn": [
        ".value"
      ]
    },
    "kraken": {
      ".read": "auth != null",
      "$slot": {
        "hp": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 59) || newData.val() === data.val() - 1) && newData.val() >= 0"
        },
        "hits": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
          }
        }
      }
    }
  }
}
